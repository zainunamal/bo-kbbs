[core]
	repositoryformatversion = 0
	filemode = true
	bare = false
	logallrefupdates = true
[remote "origin"]
	url = https://github.com/zainunamal/bo-kbbs.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
[branch "demo"]
	remote = origin
	merge = refs/heads/demo
[branch "prod-fix"]
	remote = origin
	merge = refs/heads/prod-fix
